# DeepSeek（OpenAI 协议兼容）配置
# 复制本文件为 .env 后填入真实值。.env 已在仓库根目录的 .gitignore 中。

# DeepSeek 官方：https://api.deepseek.com
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-deepseek-key
# 常见可选：deepseek-chat（通用）、deepseek-reasoner（带推理）
LLM_MODEL=deepseek-chat

# 可选：默认采样参数（不写就用代码里的默认值）
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=1024

# ── OpenTelemetry 配置（可选，uv sync --extra otel）────────
# 设为 true 启用 OTel 追踪
# OTEL_TRACING_ENABLED=true
# 导出器类型：console（终端输出）或 otlp（发送到 Collector）
# OTEL_EXPORTER_TYPE=console
# OTLP Collector 地址（仅 otlp 模式需要）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ── LangSmith 配置（可选，uv sync --extra langsmith-extra）──
# 设为 true 启用 LangSmith 追踪
# LANGSMITH_TRACING=true
# LangSmith API Key（在 https://smith.langchain.com 获取）
# LANGSMITH_API_KEY=lsv2_pt_xxxxx
# 项目名称（默认 "default"）
# LANGSMITH_PROJECT=agent-observability-demo
